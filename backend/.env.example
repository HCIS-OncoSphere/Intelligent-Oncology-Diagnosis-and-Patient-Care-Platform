# Copy this file to backend/.env and paste the real Neon DATABASE_URL that the
# team lead sent you privately. NEVER commit .env: this repo is public.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require

DEBUG=1

# Offline work only: comment out DATABASE_URL above and uncomment this line.
# USE_SQLITE=1

# E-mail (doctor approval decisions, new-account passwords). Leave EMAIL_HOST empty and the messages are
# printed in the server console instead. Gmail: smtp.gmail.com, port 587, and an "app password".
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=you@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password
# DEFAULT_FROM_EMAIL=OncoSphere <you@gmail.com>
