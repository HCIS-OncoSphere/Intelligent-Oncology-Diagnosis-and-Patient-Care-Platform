                  "try { const j = pm.response.json(); pm.collectionVariables.set('onco_patient_token', String(j.access)); } catch (e) {}",
                  ""
                ]
              }
            }
          ]
        },
        {
          "name": "Login wrong password -> 401",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/login/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "login",
                ""
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"nope\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 401', function () { pm.expect([401]).to.include(pm.response.code); });",
                  ""
                ]
              }
            }
          ]
        },
        {
          "name": "Check: patient1 has a patient profile",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/patients/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "patients",
                ""
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{onco_patient_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.expect([200]).to.include(pm.response.code); });",
                  "pm.test('patient1 has a patient profile. If this fails run: python manage.py seed', ()=>{ const j = pm.response.json(); pm.expect(Array.isArray(j) && j.length === 1).to.eql(true); });try { const j = pm.response.json(); pm.collectionVariables.set('onco_patient_id', String(j[0].id)); } catch (e) {}",
                  ""
                ]
              }
            }
          ]
        },
        {
          "name": "Check: a doctor profile exists",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/doctors/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "doctors",
                ""
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{onco_patient_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.expect([200]).to.include(pm.response.code); });",
                  "pm.test('doctor profile exists. If this fails run: python manage.py seed', ()=>{ const j = pm.response.json(); pm.expect(Array.isArray(j) && j.length > 0).to.eql(true); });try { const j = pm.response.json(); pm.collectionVariables.set('onco_doctor_id', String(j[0].id)); } catch (e) {}",
                  ""
                ]
              }
            }
          ]
        },
        {
          "name": "Setup: capture a service id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/services/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "services",
                ""
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{onco_doctor_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.expect([200]).to.include(pm.response.code); });",
                  "pm.test('a service exists. If not run: python manage.py seed', ()=>pm.expect(pm.response.json().length).to.be.above(0));try { const j = pm.response.json(); pm.collectionVariables.set('onco_service_id', String(j[0].id)); } catch (e) {}",
                  ""
                ]
              }
            }
          ]
        },
        {
          "name": "Setup: register a second patient",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/register/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "register",
                ""
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"other_{{$timestamp}}\",\n  \"password\": \"Secret1234\",\n  \"email\": \"o@example.com\",\n  \"first_name\": \"Other\",\n  \"last_name\": \"Patient\",\n  \"date_of_birth\": \"1992-02-02\",\n  \"gender\": \"M\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () { pm.expect([201]).to.include(pm.response.code); });",
                  "pm.collectionVariables.set('onco_new_username', JSON.parse(pm.request.body.raw).username);"
                ]
              }
            }
          ]
        },
        {
          "name": "Setup: login second patient",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/login/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "login",
                ""
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{onco_new_username}}\",\n  \"password\": \"Secret1234\"\n}",
              "options": {
                "raw": {
