                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.expect([200]).to.include(pm.response.code); });",
                  "try { const j = pm.response.json(); pm.collectionVariables.set('onco_new_token', String(j.access)); } catch (e) {}",
                  ""
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "10 - HL7 log (F10)",
      "item": [
        {
          "name": "List HL7 messages (staff)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/hl7/messages/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "hl7",
                "messages",
                ""
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{onco_doctor_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.expect([200]).to.include(pm.response.code); });",
                  "pm.test('has ADT/SIU/ORM/ORU', ()=>pm.expect(pm.response.json().length).to.be.above(0));try { const j = pm.response.json(); pm.collectionVariables.set('onco_hl7_id', String(j[0].id)); } catch (e) {}",
                  ""
                ]
              }
            }
          ]
        },
        {
          "name": "Get HL7 message",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/hl7/messages/{{onco_hl7_id}}/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "hl7",
                "messages",
                "{{onco_hl7_id}}",
                ""
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{onco_doctor_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.expect([200]).to.include(pm.response.code); });",
                  ""
                ]
              }
            }
          ]
        },
        {
          "name": "Resend (409 if HL7_ENABLED=0, 200 if on)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/hl7/messages/{{onco_hl7_id}}/resend/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "hl7",
                "messages",
                "{{onco_hl7_id}}",
                "resend",
                ""
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{onco_doctor_token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200/409', function () { pm.expect([200, 409]).to.include(pm.response.code); });",
                  ""
                ]
              }
            }
          ]
        },
        {
          "name": "HL7 log as patient -> 403",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/hl7/messages/",
              "host": [
