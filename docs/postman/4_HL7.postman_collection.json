                ""
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{patient_user}}\",\n  \"password\": \"{{patient_pass}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
