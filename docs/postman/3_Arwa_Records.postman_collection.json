{
  "info": {
    "name": "OncoSphere Arwa - Records, plans, orders",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run folder 0 first (stores tokens), then run the folders in order, or use the Collection Runner on the whole collection. Seed users: admin/dr.salma/patient1."
  },
  "item": [
    {
      "name": "0 - Login (run first)",
      "item": [
        {
          "name": "Login admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/login/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "login",
                ""
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{admin_user}}\",\n  \"password\": \"{{admin_pass}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.expect([200]).to.include(pm.response.code); });",
                  "try { const j = pm.response.json(); pm.collectionVariables.set('onco_admin_token', String(j.access)); } catch (e) {}",
                  ""
                ]
              }
            }
          ]
        },
